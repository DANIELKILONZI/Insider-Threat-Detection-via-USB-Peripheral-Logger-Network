FROM python:3.11-slim

LABEL maintainer="ITDN Project"
LABEL description="ITDN Central Server"

WORKDIR /app

# Create a non-root system user to run the server
RUN groupadd --system itdn && useradd --system --gid itdn --no-create-home itdn

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=itdn:itdn server/ ./server/

# Migrations ship with the image so managed deployments can run
# `docker compose exec server alembic upgrade head` instead of relying on the
# create_all path in init_db().
COPY --chown=itdn:itdn alembic/ ./alembic/
COPY --chown=itdn:itdn alembic.ini ./alembic.ini

# Ensure DB and log directories exist and are owned by the service user
RUN mkdir -p /var/lib/itdn /var/log/itdn \
    && chown -R itdn:itdn /var/lib/itdn /var/log/itdn

ENV ITDN_DB_PATH=/var/lib/itdn/itdn.db
ENV ITDN_SERVER_HOST=0.0.0.0
ENV ITDN_SERVER_PORT=8443

USER itdn

EXPOSE 8443

CMD ["python", "-m", "server.app"]
