# ITDN environment variables
# Copy this file to .env and fill in the values before running docker compose.

# ── Elasticsearch (optional alternative/complementary to Splunk) ──────────────
# ES_URL=https://es.internal:9200
# ES_API_KEY=id:api_key_value
# ES_EVENTS_INDEX=itdn-events
# ES_ALERTS_INDEX=itdn-alerts

# ── Splunk HEC ────────────────────────────────────────────────────────────────
SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector/event
SPLUNK_HEC_TOKEN=your-splunk-hec-token-here
SPLUNK_INDEX=itdn

# ── Anomaly Detection Thresholds ──────────────────────────────────────────────
# After-hours window: 22:00–06:00 UTC
ITDN_AFTER_HOURS_START=22
ITDN_AFTER_HOURS_END=6

# Volume threshold: 1 GB/hr (in bytes)
ITDN_VOLUME_THRESHOLD_BYTES=1073741824

# Rapid-cycle: 5 events in 5 minutes
ITDN_RAPID_CYCLE_COUNT=5
ITDN_RAPID_CYCLE_WINDOW_SECS=300

# Alert dedup window: 1 hour
ITDN_ALERT_DEDUP_SECS=3600

# ── Honeypot Detection ────────────────────────────────────────────────────────
# Comma-separated USB vendor IDs (first 4 hex chars of device_id) to treat as
# honeypot devices.  Leave empty to disable honeypot detection.
# Example: ITDN_HONEYPOT_VIDS=0781,058f,abcd
ITDN_HONEYPOT_VIDS=

# ── Server ────────────────────────────────────────────────────────────────────
ITDN_SERVER_PORT=8443

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite at ITDN_DB_PATH.  Override for PostgreSQL:
# ITDN_DATABASE_URL=postgresql+psycopg2://itdn:${POSTGRES_PASSWORD}@db:5432/itdn
ITDN_DB_PATH=/var/lib/itdn/itdn.db

# PostgreSQL password (used only when ITDN_DATABASE_URL is set to PostgreSQL)
# POSTGRES_PASSWORD=changeme

# ── API Security ──────────────────────────────────────────────────────────────
# Set a strong random string to enable Bearer-token auth on POST /api/v1/events.
# Leave empty to disable auth (dev / CI mode).
# NOTE: this key is NOT used to sign log anchors — see ITDN_ANCHOR_KEY below.
ITDN_API_KEY=

# ── Log Anchoring ─────────────────────────────────────────────────────────────
# The server counter-signs each agent's chain head so that an agent which later
# rewrites its own log cannot also rewrite the matching anchor. That only holds
# if the signing key is one no agent has, so ITDN_API_KEY (which every agent
# holds in order to authenticate) must never be used for it.
#
# Preferred: leave this empty and provide a readable TLS private key at
# ITDN_TLS_KEY — anchors are then RSA-signed and verifiable with the public cert.
# Otherwise set a server-only secret here:
#   openssl rand -hex 32
ITDN_ANCHOR_KEY=

# When neither a TLS private key nor ITDN_ANCHOR_KEY is available, the server
# REFUSES to anchor and returns 503, rather than storing a signature nobody can
# verify. Set this to 1 for local development to accept unverifiable anchors.
# Never enable it where tamper evidence is required.
ITDN_ALLOW_UNSIGNED_ANCHORS=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per IP per window (defaults: 200 req / 60 s)
ITDN_RATE_LIMIT_MAX=200
ITDN_RATE_LIMIT_WINDOW_SECS=60

# ── Agent: Audit Log Encryption ───────────────────────────────────────────────
# Optional 32-byte hex key (64 hex chars) for AES-256-GCM encryption of the
# local agent audit log.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty for plaintext (dev / CI mode).
ITDN_LOG_KEY=

# ── Agent: Anchor Scheduling ──────────────────────────────────────────────────
# Seconds between periodic log-chain anchor submissions to the server.
ITDN_ANCHOR_INTERVAL=300
