FROM python:3.11-slim

LABEL maintainer="ITDN Project"
LABEL description="ITDN Endpoint Agent"

WORKDIR /app

# Create a non-root system user to run the agent
RUN groupadd --system itdn && useradd --system --gid itdn --no-create-home itdn

# Install pyudev for real-time Linux USB monitoring and other agent deps
RUN pip install --no-cache-dir pyudev>=0.24 python-json-logger>=2.0 cryptography>=41.0

COPY --chown=itdn:itdn agent/ ./agent/

RUN mkdir -p /var/log/itdn /etc/itdn \
    && chown -R itdn:itdn /var/log/itdn

ENV ITDN_LOG_DIR=/var/log/itdn
ENV ITDN_LOG_LEVEL=INFO

USER itdn

CMD ["python", "-m", "agent.main"]
